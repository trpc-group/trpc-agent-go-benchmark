# LLM used for extraction, QA, and judging.
LLM_BASE_URL=
LLM_API_KEY=
LLM_NAME=gpt-4o-mini

# Embedding provider. OPENAI_* remains the fallback used by LoCoMo.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_API_KEY=
EMBED_MODEL_NAME=text-embedding-3-small
MODEL_NAME=text-embedding-3-small

# Memory services.
PGVECTOR_DSN=
MYSQL_DSN=
MEM0_HOST=http://localhost:8888
MEM0_API_KEY=
