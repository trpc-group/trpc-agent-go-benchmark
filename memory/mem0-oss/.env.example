# Required secrets. Never commit a populated .env file or publish Compose
# configuration output, which contains interpolated environment values.
POSTGRES_PASSWORD=

# These values must match the benchmark run.
LLM_NAME=glm52
MODEL_NAME=text-embedding-ada-002

# The split proxy keeps the real upstream LLM and embedding credentials out of
# this environment. This local proxy key is still treated as a secret.
MEM0_OPENAI_BASE_URL=http://host.docker.internal:18080/v1
MEM0_PROXY_API_KEY=

# Optional non-secret overrides.
MEM0_COLLECTION_NAME=memories
MEM0_PORT=8888
